{
  "name": "Match Score Engine \u2014 Score new service requests",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.data.request_type != \"targeted\") }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ServiceRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "match_score_engine_score_new_service_requests",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "calculateMatchScore",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "calculateMatchScore"
  }
}